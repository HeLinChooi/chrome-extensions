{
  "name": "leetcode-interviewer",
  "version": "0.2.0",
  "private": true,
  "description": "A mock interviewer that listens while you solve a LeetCode problem out loud.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dry-run": "node server/dry-run.js",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "listen-test": "node server/listen-test.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "zod": "^4.6.7"
  }
}
