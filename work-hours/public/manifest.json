{
  "manifest_version": 3,
  "name": "Work Hours",
  "version": "0.3.0",
  "description": "Shows each price on Shopee, Lazada and Zalora, in Malaysia and Singapore, as the hours of work it costs.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://shopee.com.my/*",
        "https://*.lazada.com.my/*",
        "https://www.zalora.com.my/*",
        "https://shopee.sg/*",
        "https://*.lazada.sg/*",
        "https://www.zalora.sg/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Work Hours",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
