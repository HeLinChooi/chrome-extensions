{
  "manifest_version": 3,
  "name": "Text Highlighter",
  "version": "1.2",
  "description": "Highlight text on any webpage with yellow color",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}